# Copy these into .env (which is git-ignored) and fill them in.

# MongoDB connection string: Atlas, or a local server such as
# mongodb://127.0.0.1:27017/ptsc
MONGODB_URI=

# Secret used to sign login cookies. Must be at least 32 random characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public address of this site, e.g. https://ptsc.app (no trailing slash). Set it in
# production: it is used for the canonical links, share images, sitemap and RSS feed
# that search engines read, and it is also accepted as a valid origin for form posts
# (useful if the site is reached through a proxy under a different hostname). Without
# it, Vercel's production URL is used, then http://localhost:3000.
APP_URL=

# Cloudinary, for uploading event cover images (Cloudinary dashboard -> API Keys).
# Optional: without these, the cover image field still accepts a pasted link.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# First admin account, created automatically at the end of each Production
# deploy on Vercel (see scripts/setup-admin.ts). Set these in Vercel under
# Project -> Settings -> Environment Variables, not in a committed file.
# Safe to leave in place: an existing admin is never changed unless you ask.
ADMIN_EMAIL=
# Needed only when the account doesn't exist yet (min 8 characters). Once the
# admin exists you can delete this variable.
ADMIN_PASSWORD=
# Needed only when the account doesn't exist yet (10 digits).
ADMIN_MOBILE=
# Optional. Defaults: PTSC / Admin, and a username made from the email.
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_USERNAME=
# Set to "true" (together with ADMIN_PASSWORD) to replace an existing admin's
# password on the next deploy. Remove it afterwards.
ADMIN_RESET_PASSWORD=
