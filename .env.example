# Copy these into .env (which is git-ignored) and fill them in.

# MongoDB connection string: Atlas, or a local server such as
# mongodb://127.0.0.1:27017/ptsc
MONGODB_URI=

# Secret used to sign login cookies. Must be at least 32 random characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public address of this site, e.g. https://ptsc.app. Optional for now: when
# set, it's also accepted as a valid origin for form posts (useful if the site
# is reached through a proxy under a different hostname). Later phases use it
# for links inside emails.
APP_URL=

# Cloudinary, for uploading event cover images (Cloudinary dashboard -> API Keys).
# Optional: without these, the cover image field still accepts a pasted link.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
